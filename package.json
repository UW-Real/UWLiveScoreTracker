{
  "name": "uw-score-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node app.js",
    "start": "NODE_ENV=production node app.js",
    "build": "next build",
    "lint": "eslint",
    "collect:scores": "node api/collectScores.js",
    "test:scores": "node --test api/tests/*.test.js",
    "test:scores:integration": "node --test api/tests/football.integration.js",
    "smoke:scores": "node api/footballSmoke.js",
    "supabase:link": "npx supabase link",
    "supabase:preview": "npx supabase db push --dry-run",
    "supabase:push": "npx supabase db push",
    "supabase:migration": "npx supabase migration new",
    "supabase:test": "npx supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4"
  }
}
